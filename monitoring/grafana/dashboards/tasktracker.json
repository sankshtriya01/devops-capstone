{
  "title": "TaskTracker Overview",
  "uid": "tasktracker-overview",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(http_requests_total[1m]))", "legendFormat": "all requests" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Error rate (5xx)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) / sum(rate(http_requests_total[1m]))",
        "legendFormat": "error ratio"
      }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Average response time (seconds)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(http_request_duration_seconds_sum[1m])) / sum(rate(http_request_duration_seconds_count[1m]))",
        "legendFormat": "avg latency"
      }]
    },
    {
      "id": 4, "type": "stat", "title": "Tasks stored",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "tasks_total" }]
    },
    {
      "id": 5, "type": "stat", "title": "Running version",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "app_info", "legendFormat": "{{version}}" }]
    },
    {
      "id": 6, "type": "logs", "title": "Application logs",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "datasource": "Loki",
      "targets": [{ "expr": "{container=~\".*app.*\"}" }]
    }
  ]
}
